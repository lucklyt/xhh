#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PY="$SCRIPT_DIR/.venv/bin/python"

if [ ! -x "$VENV_PY" ]; then
  PY_BIN=""
  for cand in \
    "/opt/homebrew/bin/python3.14" \
    "/opt/homebrew/opt/python@3.14/bin/python3.14" \
    "/opt/homebrew/bin/python3.13" \
    "/opt/homebrew/bin/python3.12" \
    "/opt/homebrew/bin/python3.11" \
    "/opt/homebrew/bin/python3" \
    "python3.14" "python3.13" "python3.12" "python3.11" "python3.10" "python3.9" "python3"; do
    resolved="$cand"
    if [ ! -x "$resolved" ]; then
      resolved="$(command -v "$cand" 2>/dev/null || true)"
    fi
    if [ -n "$resolved" ] && "$resolved" -c 'import sys, venv, ensurepip; assert sys.version_info >= (3, 9)' >/dev/null 2>&1; then
      PY_BIN="$resolved"
      break
    fi
  done

  if [ -z "$PY_BIN" ]; then
    echo "[xhh] 未找到可用的 Python >= 3.9（需含 venv/ensurepip 模块）" >&2
    exit 1
  fi

  echo "[xhh] 首次运行，正在初始化虚拟环境并安装依赖..."
  "$PY_BIN" -m venv "$SCRIPT_DIR/.venv"
  "$SCRIPT_DIR/.venv/bin/pip" install -e "$SCRIPT_DIR"
fi

exec "$VENV_PY" -m xhh.cli "$@"
