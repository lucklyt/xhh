/* =========================================================
 * 小黑盒 TUI 双主题样式表
 * 1) elegant: 华丽炫彩夜空蓝主题（丰富图标、高亮边框、鲜明层次）
 * 2) .theme-stealth (默认): 极简低调终端灰阶主题（零 Emoji、融入命令行）
 * ========================================================= */

Screen {
    background: #0b0f19;
    color: #f1f5f9;
}

#top-bar {
    height: 1;
    background: #162038;
    padding: 0 1;
    layout: horizontal;
    align-vertical: middle;
}

#top-title {
    width: 1fr;
    content-align: left middle;
    text-style: bold;
    color: #38bdf8;
}

#top-account {
    width: auto;
    content-align: right middle;
    color: #fbbf24;
}

#main-body {
    height: 1fr;
    layout: horizontal;
}

#sidebar {
    width: 26;
    height: 1fr;
    background: #0f172a;
    border-right: solid #2563eb;
    padding: 0;
}

#sidebar-list {
    height: 1fr;
    background: #0f172a;
    border: none;
    padding: 0 1;
    scrollbar-size: 0 0;
}

#content-switcher {
    width: 1fr;
    height: 1fr;
    background: #0b0f19;
}

#list-pane {
    height: 1fr;
    layout: vertical;
}

#list-subbar {
    height: 1;
    background: #131c31;
    padding: 0 1;
    content-align: left middle;
    color: #93c5fd;
}

#feed-list {
    height: 1fr;
    background: #0b0f19;
    border: none;
    padding: 0 1;
    scrollbar-size: 0 0;
}

#detail-pane {
    height: 1fr;
    layout: vertical;
}

#detail-header {
    height: 1;
    max-height: 1;
    background: #162038;
    padding: 0 1;
    content-align: left middle;
}

#detail-tabbar {
    height: 1;
    background: #131c31;
    padding: 0 1;
    content-align: left middle;
    color: #93c5fd;
}

#detail-sub-switcher {
    height: 1fr;
}

#detail-body-view, #detail-comments-view {
    height: 1fr;
    layout: vertical;
}

#post-body-scroll {
    height: 1fr;
    background: #0b0f19;
    padding: 1 2;
}

#post-body-scroll:focus {
    border-left: thick #38bdf8;
}

#image-pills-bar {
    height: auto;
    max-height: 3;
    background: #131c31;
    border-top: solid #2563eb;
    padding: 0 1;
    layout: horizontal;
    display: none;
}

.image-pill {
    width: auto;
    height: 1;
    background: #312e81;
    color: #e0e7ff;
    padding: 0 1;
    margin-right: 1;
}

.image-pill:hover {
    background: #38bdf8;
    color: #0b0f19;
    text-style: bold;
}

#comment-bar {
    display: none;
}

#comment-list {
    height: 1fr;
    background: #0b0f19;
    border: none;
    padding: 0 1;
    scrollbar-size: 0 0;
}

#comment-list:focus {
    border-left: thick #fbbf24;
}

#status-footer {
    height: 1;
    background: #162038;
    color: #93c5fd;
    padding: 0 1;
}

OptionList > .option-list--option-highlighted {
    background: #1e293b;
    color: #ffffff;
}

OptionList:focus > .option-list--option-highlighted {
    background: #1d4ed8;
    color: #ffffff;
    text-style: bold;
}

/* Modals (elegant 华丽主题) */
QRLoginModal, SearchModal, SubCommentModal, ImagePreviewModal, CommentModal, NewPostModal {
    align: center middle;
    background: rgba(8, 12, 24, 0.78);
}

#qr-dialog {
    width: 60;
    height: auto;
    max-height: 100%;
    background: #111827;
    border: round #38bdf8;
    padding: 0 1;
    layout: vertical;
    align-horizontal: center;
}

#qr-title {
    height: 1;
    text-align: center;
    text-style: bold;
    color: #38bdf8;
    margin: 0;
}

#qr-scroll {
    width: auto;
    height: auto;
    max-height: 1fr;
    align: center middle;
    margin: 0;
    scrollbar-size: 0 0;
}

#qr-box {
    width: auto;
    height: auto;
    content-align: center middle;
    padding: 0;
    background: #ffffff;
    color: #000000;
    margin: 0;
}

#qr-status {
    height: 1;
    text-align: center;
    color: #fbbf24;
    margin: 0;
}

#search-dialog {
    width: 82;
    height: 80%;
    background: #111827;
    border: heavy #38bdf8;
    padding: 1 2;
    layout: vertical;
}

#search-title {
    text-style: bold;
    color: #38bdf8;
    margin-bottom: 1;
}

#search-input {
    margin-bottom: 1;
}

#search-status {
    height: 1;
    color: #93c5fd;
    margin-bottom: 1;
}

#search-results {
    height: 1fr;
    background: #0b0f19;
    border: solid #2563eb;
}

#subcomment-dialog {
    width: 86;
    height: 82%;
    background: #111827;
    border: heavy #fbbf24;
    padding: 1 2;
    layout: vertical;
}

#subcomment-root {
    height: auto;
    max-height: 8;
    background: #0b0f19;
    border: solid #2563eb;
    padding: 1;
    margin-bottom: 1;
}

#subcomment-list {
    height: 1fr;
    background: #0b0f19;
    border: solid #2563eb;
}

#subcomment-hint {
    height: 1;
    color: #93c5fd;
    margin-top: 1;
}

#boss-screen-log {
    height: 1fr;
    padding: 1 2;
    background: #0c0c0c;
    color: #cccccc;
}

#img-preview-dialog {
    width: auto;
    max-width: 92%;
    height: auto;
    max-height: 95%;
    background: #111827;
    border: round #38bdf8;
    padding: 0 1;
    layout: vertical;
    align-horizontal: center;
}

#img-preview-title {
    height: 1;
    text-align: center;
    text-style: bold;
    color: #38bdf8;
}

#img-preview-box {
    width: auto;
    height: auto;
    content-align: center middle;
    padding: 0;
    background: #0b0f19;
}

#img-preview-hint {
    height: 1;
    text-align: center;
    color: #93c5fd;
}

#comment-dialog {
    width: 78;
    height: auto;
    background: #111827;
    border: heavy #4ade80;
    padding: 1 2;
    layout: vertical;
}

#comment-title {
    text-style: bold;
    color: #4ade80;
    margin-bottom: 1;
}

#comment-target {
    color: #93c5fd;
    margin-bottom: 1;
}

#comment-input {
    margin-bottom: 1;
}

#comment-status {
    height: 1;
    color: #fbbf24;
}

#newpost-dialog {
    width: 84;
    height: 85%;
    background: #111827;
    border: heavy #38bdf8;
    padding: 1 2;
    layout: vertical;
}

#newpost-title {
    text-style: bold;
    color: #38bdf8;
    margin-bottom: 1;
}

#post-topic-input, #post-title-input, #post-images-input {
    margin-bottom: 1;
}

#post-content-area {
    height: 1fr;
    margin-bottom: 1;
}

#newpost-status {
    height: 1;
    color: #fbbf24;
    margin-bottom: 1;
}

#newpost-actions {
    height: 3;
    layout: horizontal;
    align-horizontal: right;
}

#newpost-actions Button {
    margin-left: 1;
}

/* =========================================================
 * stealth (默认): 极简低调终端灰阶主题
 * ========================================================= */

App.theme-stealth Screen {
    background: #101214;
    color: #b0b8c0;
}

.theme-stealth #top-bar,
.theme-stealth #detail-header,
.theme-stealth #status-footer {
    background: #141619;
    color: #687078;
}

.theme-stealth #top-title {
    text-style: none;
    color: #9aa3ad;
}

.theme-stealth #top-account {
    color: #687078;
}

.theme-stealth #sidebar,
.theme-stealth #sidebar-list {
    background: #101214;
    border-right: solid #22252a;
    color: #9aa3ad;
}

.theme-stealth #sidebar-list {
    border-right: none;
}

.theme-stealth #content-switcher,
.theme-stealth #feed-list,
.theme-stealth #post-body-scroll,
.theme-stealth #comment-list {
    background: #101214;
    color: #b0b8c0;
}

.theme-stealth #list-subbar,
.theme-stealth #detail-tabbar {
    background: #121417;
    color: #687078;
}

.theme-stealth #image-pills-bar {
    background: #121417;
    color: #687078;
    border-top: solid #22252a;
}

.theme-stealth #post-body-scroll:focus,
.theme-stealth #comment-list:focus {
    border-left: solid #484f58;
}

.theme-stealth .image-pill {
    background: #1a1d22;
    color: #8b949e;
}

.theme-stealth .image-pill:hover {
    background: #2d333b;
    color: #d0d7de;
}

.theme-stealth OptionList > .option-list--option-highlighted {
    background: #181b20;
    color: #c9d1d9;
}

.theme-stealth OptionList:focus > .option-list--option-highlighted {
    background: #21252b;
    color: #d0d7de;
    text-style: none;
}

.theme-stealth #qr-dialog,
.theme-stealth #search-dialog,
.theme-stealth #subcomment-dialog,
.theme-stealth #img-preview-dialog,
.theme-stealth #comment-dialog,
.theme-stealth #newpost-dialog {
    background: #141619;
    border: solid #30363d;
}

.theme-stealth #qr-title,
.theme-stealth #search-title,
.theme-stealth #img-preview-title,
.theme-stealth #comment-title,
.theme-stealth #newpost-title {
    color: #b0b8c0;
}

.theme-stealth #qr-status,
.theme-stealth #search-status,
.theme-stealth #subcomment-hint,
.theme-stealth #img-preview-hint,
.theme-stealth #comment-target,
.theme-stealth #comment-status,
.theme-stealth #newpost-status {
    color: #687078;
}

.theme-stealth #search-results,
.theme-stealth #subcomment-root,
.theme-stealth #subcomment-list {
    background: #101214;
    border: solid #22252a;
}

.theme-stealth #img-preview-box {
    background: #101214;
}
