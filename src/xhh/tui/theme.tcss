Screen {
    background: #0d1117;
    color: #e6edf3;
}

#top-bar {
    height: 1;
    background: #161b22;
    padding: 0 1;
    layout: horizontal;
    align-vertical: middle;
}

#top-title {
    width: 1fr;
    content-align: left middle;
    color: #e6edf3;
}

#top-account {
    width: auto;
    content-align: right middle;
    color: #8b949e;
}

#main-body {
    height: 1fr;
    layout: horizontal;
}

#sidebar {
    width: 26;
    height: 1fr;
    background: #10151c;
    border-right: solid #30363d;
    padding: 0;
}

#sidebar-list {
    height: 1fr;
    background: #10151c;
    border: none;
    padding: 0 1;
}

#content-switcher {
    width: 1fr;
    height: 1fr;
    background: #0d1117;
}

#list-pane {
    height: 1fr;
    layout: vertical;
}

#list-subbar {
    height: 1;
    background: #131920;
    padding: 0 1;
    content-align: left middle;
    color: #8b949e;
}

#feed-list {
    height: 1fr;
    background: #0d1117;
    border: none;
    padding: 0 1;
    scrollbar-size: 0 0;
}

#detail-pane {
    height: 1fr;
    layout: vertical;
}

#detail-header {
    height: 1;
    max-height: 1;
    background: #161b22;
    padding: 0 1;
    content-align: left middle;
}

#detail-tabbar {
    height: 1;
    background: #131920;
    padding: 0 1;
    content-align: left middle;
    color: #8b949e;
}

#detail-sub-switcher {
    height: 1fr;
}

#detail-body-view, #detail-comments-view {
    height: 1fr;
    layout: vertical;
}

#post-body-scroll {
    height: 1fr;
    background: #0d1117;
    padding: 1 2;
}

#post-body-scroll:focus {
    border-left: thick #58a6ff;
}

#image-pills-bar {
    height: auto;
    max-height: 3;
    background: #131920;
    border-top: solid #21262d;
    padding: 0 1;
    layout: horizontal;
    display: none;
}

.image-pill {
    width: auto;
    height: 1;
    background: #1f3a5f;
    color: #e6edf3;
    padding: 0 1;
    margin-right: 1;
}

.image-pill:hover {
    background: #58a6ff;
    color: #0d1117;
    text-style: bold;
}

#comment-bar {
    display: none;
}

#comment-list {
    height: 1fr;
    background: #0d1117;
    border: none;
    padding: 0 1;
    scrollbar-size: 0 0;
}

#comment-list:focus {
    border-left: thick #f0883e;
}

#status-footer {
    height: 1;
    background: #161b22;
    color: #8b949e;
    padding: 0 1;
}

OptionList > .option-list--option-highlighted {
    background: #1f2937;
    color: #ffffff;
}

OptionList:focus > .option-list--option-highlighted {
    background: #1f3a5f;
    color: #ffffff;
}

/* Modals */
QRLoginModal, SearchModal, SubCommentModal, ImagePreviewModal, CommentModal, NewPostModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#qr-dialog {
    width: 60;
    height: auto;
    max-height: 100%;
    background: #161b22;
    border: round #58a6ff;
    padding: 0 1;
    layout: vertical;
    align-horizontal: center;
}

#qr-title {
    height: 1;
    text-align: center;
    text-style: bold;
    color: #58a6ff;
    margin: 0;
}

#qr-scroll {
    width: auto;
    height: auto;
    max-height: 1fr;
    align: center middle;
    margin: 0;
    scrollbar-size: 0 0;
}

#qr-box {
    width: auto;
    height: auto;
    content-align: center middle;
    padding: 0;
    background: #ffffff;
    color: #000000;
    margin: 0;
}

#qr-status {
    height: 1;
    text-align: center;
    color: #f0883e;
    margin: 0;
}

#search-dialog {
    width: 82;
    height: 80%;
    background: #161b22;
    border: heavy #58a6ff;
    padding: 1 2;
    layout: vertical;
}

#search-title {
    text-style: bold;
    color: #58a6ff;
    margin-bottom: 1;
}

#search-input {
    margin-bottom: 1;
}

#search-status {
    height: 1;
    color: #8b949e;
    margin-bottom: 1;
}

#search-results {
    height: 1fr;
    background: #0d1117;
    border: solid #30363d;
}

#subcomment-dialog {
    width: 86;
    height: 82%;
    background: #161b22;
    border: heavy #f0883e;
    padding: 1 2;
    layout: vertical;
}

#subcomment-root {
    height: auto;
    max-height: 8;
    background: #0d1117;
    border: solid #30363d;
    padding: 1;
    margin-bottom: 1;
}

#subcomment-list {
    height: 1fr;
    background: #0d1117;
    border: solid #30363d;
}

#subcomment-hint {
    height: 1;
    color: #8b949e;
    margin-top: 1;
}

#boss-screen-log {
    height: 1fr;
    padding: 1 2;
    background: #0c0c0c;
    color: #cccccc;
}

#img-preview-dialog {
    width: auto;
    max-width: 92%;
    height: auto;
    max-height: 95%;
    background: #161b22;
    border: round #58a6ff;
    padding: 0 1;
    layout: vertical;
    align-horizontal: center;
}

#img-preview-title {
    height: 1;
    text-align: center;
    text-style: bold;
    color: #58a6ff;
}

#img-preview-box {
    width: auto;
    height: auto;
    content-align: center middle;
    padding: 0;
    background: #0d1117;
}

#img-preview-hint {
    height: 1;
    text-align: center;
    color: #8b949e;
}

#comment-dialog {
    width: 78;
    height: auto;
    background: #161b22;
    border: heavy #3fb950;
    padding: 1 2;
    layout: vertical;
}

#comment-title {
    text-style: bold;
    color: #3fb950;
    margin-bottom: 1;
}

#comment-target {
    color: #8b949e;
    margin-bottom: 1;
}

#comment-input {
    margin-bottom: 1;
}

#comment-status {
    height: 1;
    color: #f0883e;
}

#newpost-dialog {
    width: 84;
    height: 85%;
    background: #161b22;
    border: heavy #58a6ff;
    padding: 1 2;
    layout: vertical;
}

#newpost-title {
    text-style: bold;
    color: #58a6ff;
    margin-bottom: 1;
}

#post-topic-input, #post-title-input {
    margin-bottom: 1;
}

#post-content-area {
    height: 1fr;
    margin-bottom: 1;
}

#newpost-status {
    height: 1;
    color: #f0883e;
    margin-bottom: 1;
}

#newpost-actions {
    height: 3;
    layout: horizontal;
    align-horizontal: right;
}

#newpost-actions Button {
    margin-left: 1;
}
