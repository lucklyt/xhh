Screen {
    background: #0d1117;
    color: #e6edf3;
}

#top-bar {
    height: 3;
    background: #161b22;
    border-bottom: solid #30363d;
    padding: 0 2;
    layout: horizontal;
    align-vertical: middle;
}

#top-title {
    width: 1fr;
    content-align: left middle;
    color: #e6edf3;
}

#top-account {
    width: auto;
    content-align: right middle;
    color: #8b949e;
}

#main-body {
    height: 1fr;
    layout: horizontal;
}

#sidebar {
    width: 28;
    height: 1fr;
    background: #10151c;
    border-right: solid #30363d;
    padding: 0;
}

#sidebar-list {
    height: 1fr;
    background: #10151c;
    border: none;
    padding: 0 1;
}

#content-switcher {
    width: 1fr;
    height: 1fr;
    background: #0d1117;
}

#list-pane {
    height: 1fr;
    layout: vertical;
}

#list-subbar {
    height: 2;
    background: #131920;
    border-bottom: solid #21262d;
    padding: 0 2;
    content-align: left middle;
    color: #8b949e;
}

#feed-list {
    height: 1fr;
    background: #0d1117;
    border: none;
    padding: 0 1;
}

#detail-pane {
    height: 1fr;
    layout: vertical;
}

#detail-header {
    height: auto;
    max-height: 5;
    background: #161b22;
    border-bottom: solid #30363d;
    padding: 0 2;
}

#detail-tabbar {
    height: 2;
    background: #131920;
    border-bottom: solid #21262d;
    padding: 0 2;
    content-align: left middle;
    color: #8b949e;
}

#detail-sub-switcher {
    height: 1fr;
}

#detail-body-view, #detail-comments-view {
    height: 1fr;
    layout: vertical;
}

#post-body-scroll {
    height: 1fr;
    background: #0d1117;
    padding: 1 2;
}

#post-body-scroll:focus {
    border-left: thick #58a6ff;
}

#comment-bar {
    height: 2;
    background: #131920;
    border-bottom: solid #21262d;
    padding: 0 2;
    content-align: left middle;
    color: #8b949e;
}

#comment-list {
    height: 1fr;
    background: #0d1117;
    border: none;
    padding: 0 1;
}

#comment-list:focus {
    border-left: thick #f0883e;
}

#status-footer {
    height: 1;
    background: #161b22;
    border-top: solid #30363d;
    color: #8b949e;
    padding: 0 2;
}

OptionList > .option-list--option-highlighted {
    background: #1f2937;
    color: #ffffff;
}

OptionList:focus > .option-list--option-highlighted {
    background: #1f3a5f;
    color: #ffffff;
}

/* Modals */
QRLoginModal, SearchModal, SubCommentModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#qr-dialog {
    width: 90;
    height: auto;
    max-height: 98%;
    background: #161b22;
    border: heavy #58a6ff;
    padding: 0 2;
    layout: vertical;
    align-horizontal: center;
}

#qr-title {
    text-align: center;
    text-style: bold;
    color: #58a6ff;
    margin-top: 1;
}

#qr-account-banner {
    text-align: center;
    color: #3fb950;
}

#qr-scroll {
    width: auto;
    height: auto;
    max-height: 1fr;
    align: center middle;
    margin: 1 0;
}

#qr-box {
    width: auto;
    height: auto;
    content-align: center middle;
    padding: 0;
    background: #ffffff;
    color: #000000;
    margin: 0;
}

#qr-status {
    text-align: center;
    color: #f0883e;
}

#qr-hint {
    text-align: center;
    color: #8b949e;
    margin-bottom: 1;
}

#search-dialog {
    width: 82;
    height: 75%;
    background: #161b22;
    border: heavy #58a6ff;
    padding: 1 2;
    layout: vertical;
}

#search-title {
    text-style: bold;
    color: #58a6ff;
    margin-bottom: 1;
}

#search-input {
    margin-bottom: 1;
}

#search-status {
    height: 1;
    color: #8b949e;
    margin-bottom: 1;
}

#search-results {
    height: 1fr;
    background: #0d1117;
    border: solid #30363d;
}

#subcomment-dialog {
    width: 86;
    height: 80%;
    background: #161b22;
    border: heavy #f0883e;
    padding: 1 2;
    layout: vertical;
}

#subcomment-root {
    height: auto;
    max-height: 8;
    background: #0d1117;
    border: solid #30363d;
    padding: 1;
    margin-bottom: 1;
}

#subcomment-list {
    height: 1fr;
    background: #0d1117;
    border: solid #30363d;
}

#subcomment-hint {
    height: 1;
    color: #8b949e;
    margin-top: 1;
}

#boss-screen-log {
    height: 1fr;
    padding: 1 2;
    background: #0c0c0c;
    color: #cccccc;
}
